}

// ==================== 我的页 ====================
class ProfilePage extends StatefulWidget {
  const ProfilePage({Key? key}) : super(key: key);
  @override State<ProfilePage> createState() => _ProfilePageState();
}
class _ProfilePageState extends State<ProfilePage> {
  String _avatar = ''; String _name = '用户';

  @override void initState() { super.initState(); _load(); }
  void _load() async {
    final prefs = await SharedPreferences.getInstance();
    setState(() { _avatar = prefs.getString('user_avatar') ?? ''; _name = prefs.getString('user_name') ?? '用户'; });
  }

  void _pickAvatar() async {
    final p = await ImagePicker().pickImage(source: ImageSource.gallery, maxWidth: 512);
    if (p != null) {
      String path = p.path;
      if (path.toLowerCase().endsWith('.heic')) { try { path = await HeifConverter.convert(path); } catch (_) {} }
      final dir = await getApplicationDocumentsDirectory();
      final dest = '${dir.path}/user_avatar.png';
      await File(path).copy(dest);
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString('user_avatar', dest);
      setState(() => _avatar = dest);
    }
  }

  void _editName() async {
    final c = TextEditingController(text: _name);
    await TideDialogs.show(context: context, builder: (ctx) => AlertDialog(backgroundColor: Colors.transparent, contentPadding: EdgeInsets.zero, content: TideDialogs.glassContent(context: ctx, children: [
      const Text('修改名字', style: TextStyle(fontSize: 16, fontWeight: FontWeight.w700, fontFamily: 'TideFont')),
      const SizedBox(height: 10),
      TextField(controller: c, decoration: const InputDecoration(hintText: '输入名字', border: OutlineInputBorder(borderRadius: BorderRadius.all(Radius.circular(10))))),
      const SizedBox(height: 12),
      TideDialogs.glassButton('保存', onTap: () async {
        final prefs = await SharedPreferences.getInstance(); await prefs.setString('user_name', c.text);
        Navigator.pop(ctx); setState(() => _name = c.text);
      }),
    ])));
  }

  @override Widget build(BuildContext context) {
    return Scaffold(backgroundColor: Colors.transparent, body: SafeArea(child: SingleChildScrollView(padding: const EdgeInsets.fromLTRB(16, 8, 16, 100), child: Column(children: [
      // 头像+名字卡片
      GlassCard(radius: 22, padding: const EdgeInsets.all(20), child: Column(children: [
        GestureDetector(onTap: _pickAvatar, child: Container(width: 72, height: 72, decoration: BoxDecoration(shape: BoxShape.circle, color: const Color(0xFFE8E8F0), image: _avatar.isNotEmpty ? DecorationImage(image: FileImage(File(_avatar)), fit: BoxFit.cover) : null), child: _avatar.isEmpty ? const Icon(Icons.person, size: 36, color: Color(0xFF6B5B95)) : null)),
        const SizedBox(height: 10),
        GestureDetector(onTap: _editName, child: Text(_name, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
      ])),
      const SizedBox(height: 20),

      // 设置列表
      _settingTile(Icons.api_rounded, 'API设置', () => _openApiSetup()),
      _settingTile(Icons.palette_rounded, '主题设置', () {}),
      _settingTile(Icons.wallpaper_rounded, '聊天背景', () {}),
      _settingTile(Icons.link_rounded, '绑定微信', () {}),
      _settingTile(Icons.tune_rounded, '普通设置', () {}),
      _settingTile(Icons.build_rounded, '高级设置', () {}),
      _settingTile(Icons.favorite_rounded, '支持我们', () {}),
      _settingTile(Icons.info_outline_rounded, '关于应用', () {}),
    ]))));
  }

  Widget _settingTile(IconData ic, String t, VoidCallback cb) {
    return GestureDetector(onTap: cb, child: Container(margin: const EdgeInsets.only(bottom: 2), padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14), decoration: BoxDecoration(color: Colors.white.withOpacity(0.6), borderRadius: BorderRadius.circular(14)), child: Row(children: [Icon(ic, size: 22, color: const Color(0xFF6B5B95)), const SizedBox(width: 12), Expanded(child: Text(t, style: const TextStyle(fontSize: 15, fontFamily: 'TideFont'))), const Icon(Icons.chevron_right_rounded, size: 18, color: Color(0xFFC7C7CC))])));
  }

  void _openApiSetup() {
    Navigator.push(context, PageRouteBuilder(pageBuilder: (c, a, s) => const ApiSetupPage(), transitionsBuilder: (c, a, s, child) => SlideTransition(position: Tween<Offset>(begin: const Offset(0.15, 0), end: Offset.zero).animate(CurvedAnimation(parent: a, curve: Curves.easeOutCubic)), child: child)));
  }
}

// ==================== API设置页 ====================
class ApiSetupPage extends StatefulWidget {
  const ApiSetupPage({Key? key}) : super(key: key);
  @override State<ApiSetupPage> createState() => _ApiSetupPageState();
}
class _ApiSetupPageState extends State<ApiSetupPage> {
  List<Map> _providers = [];
  final _presets = {
    'DeepSeek': 'https://api.deepseek.com/v1',
    'SiliconFlow': 'https://api.siliconflow.cn/v1',
    'GiteeAI': 'https://ai.gitee.com/v1',
    '阿里云百炼': 'https://dashscope.aliyuncs.com/compatible-mode/v1',
    'Kimi': 'https://api.moonshot.cn/v1',
  };
  final _ttsPresets = ['SiliconFlow', '阿里云百炼', 'MiniMax'];

  @override void initState() { super.initState(); _load(); }
  void _load() async { final p = await DBManager().queryProviders(); setState(() => _providers = p); }

  void _addProvider() {
    final urlC = TextEditingController(); final nameC = TextEditingController(); final keyC = TextEditingController(); final modelC = TextEditingController(); String? type;
    TideDialogs.show(context: context, builder: (ctx) => AlertDialog(backgroundColor: Colors.transparent, contentPadding: EdgeInsets.zero, content: TideDialogs.glassContent(context: ctx, maxWidth: 0.88, children: [
      const Center(child: Text('添加模型提供商', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
      const SizedBox(height: 12),
      // 预设选择
      Wrap(spacing: 8, children: [
        for (var k in _presets.keys)
          GestureDetector(onTap: () { urlC.text = _presets[k]!; nameC.text = k; type = k; }, child: Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6), decoration: BoxDecoration(color: type == k ? const Color(0xFF6B5B95) : const Color(0xFFE8E8F0), borderRadius: BorderRadius.circular(10)), child: Text(k, style: TextStyle(color: type == k ? Colors.white : const Color(0xFF3C3C43), fontSize: 13, fontFamily: 'TideFont')))),
        GestureDetector(onTap: () { urlC.text = ''; nameC.text = ''; type = '自定义'; }, child: Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6), decoration: BoxDecoration(color: type == '自定义' ? const Color(0xFF6B5B95) : const Color(0xFFE8E8F0), borderRadius: BorderRadius.circular(10)), child: const Text('自定义', style: TextStyle(fontSize: 13, fontFamily: 'TideFont')))),
      ]),
      const SizedBox(height: 12),
      _miniField(nameC, '提供商名称'), const SizedBox(height: 8),
      _miniField(urlC, 'API Base URL'), const SizedBox(height: 8),
      _miniField(keyC, 'API Key', obscure: true), const SizedBox(height: 8),
      _miniField(modelC, '模型标识(如deepseek-chat)'), const SizedBox(height: 14),
      Row(children: [
        Expanded(child: TideDialogs.glassButton('取消', onTap: () => Navigator.pop(ctx), color: const Color(0xFFE8E8F0), textColor: const Color(0xFF1C1C1E))),
        const SizedBox(width: 8),
        Expanded(child: TideDialogs.glassButton('测试', onTap: () async {
          // 测试连接
          try {
            final resp = await AIManager().testConnection(urlC.text, keyC.text, modelC.text);
            if (mounted) ScaffoldMessenger.of(ctx).showSnackBar(SnackBar(content: Text('连接成功! 延迟: ${resp}ms', style: const TextStyle(fontFamily: 'TideFont')), backgroundColor: const Color(0xFF6B5B95)));
          } catch (e) {
            if (mounted) ScaffoldMessenger.of(ctx).showSnackBar(SnackBar(content: Text('连接失败: $e', style: const TextStyle(fontFamily: 'TideFont')), backgroundColor: const Color(0xFFE74C3C)));
          }
        }, color: const Color(0xFFFFB5A7), textColor: const Color(0xFF1C1C1E))),
        const SizedBox(width: 8),
        Expanded(child: TideDialogs.glassButton('保存', onTap: () async {
          await DBManager().insertProvider({'id': 'pvd_${DateTime.now().millisecondsSinceEpoch}', 'name': nameC.text, 'url': urlC.text, 'key': keyC.text, 'model': modelC.text});
