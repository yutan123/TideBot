// ==================== 空间页 ====================
class SpacePage extends StatefulWidget {
  const SpacePage({Key? key}) : super(key: key);
  @override State<SpacePage> createState() => _SpacePageState();
}
class _SpacePageState extends State<SpacePage> {
  String _botId = ''; String _botName = '未连接'; String _dailyQuote = '正在加载...';
  int _daysSince = 0; String _meetDate = ''; String _mood = '开心';
  List<Map> _schedules = []; List<Map> _diaries = []; List<Map> _bots = [];

  @override void initState() { super.initState(); _load(); }
  void _load() async {
    final bots = await DBManager().queryBots();
    if (bots.isNotEmpty) {
      final bid = bots.first['id'] as String;
      final quotes = await DBManager().getKV('daily_quote_$bid');
      final meet = await DBManager().getKV('meet_date_$bid') ?? '${DateTime.now().year}.${DateTime.now().month}.1';
      final moods = await DBManager().getKV('last_mood_$bid') ?? '开心';
      final schs = await DBManager().querySchedules(bid, limit: 2);
      final dis = await DBManager().queryMemories(bid, type: 'medium', limit: 2);
      final meetDt = DateTime.tryParse(meet) ?? DateTime.now();
      setState(() {
        _botId = bid; _botName = bots.first['name'] ?? '';
        _dailyQuote = quotes ?? '今天也是元气满满的一天~'; _mood = moods;
        _schedules = schs; _diaries = dis; _bots = bots;
        _meetDate = meet; _daysSince = DateTime.now().difference(meetDt).inDays + 1;
      });
    } else {
      setState(() { _dailyQuote = '请先创建一个机器人'; _bots = bots; });
    }
  }

  String _now() {
    final d = DateTime.now();
    final week = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
    return '${d.month}月${d.day}日 ${week[d.weekday % 7]}';
  }

  String _nowTime() {
    final d = DateTime.now();
    return '${d.hour.toString().padLeft(2, '0')}:${d.minute.toString().padLeft(2, '0')}';
  }

  void _selectBot() async {
    final prefs = await SharedPreferences.getInstance();
    showTideSheet(context: context, height: 350, child: ListView(children: [
      for (var b in _bots)
        ListTile(
          leading: (b['avatar'] as String?)?.isNotEmpty == true ? ClipRRect(borderRadius: BorderRadius.circular(10), child: Image.file(File(b['avatar']), width: 36, height: 36, fit: BoxFit.cover)) : const Icon(Icons.person, color: Color(0xFF6B5B95)),
          title: Text(b['name'] ?? '', style: const TextStyle(fontFamily: 'TideFont')),
          trailing: _botId == b['id'] ? const Icon(Icons.check, color: Color(0xFF6B5B95)) : null,
          onTap: () { Navigator.pop(context); setState(() { _botId = b['id']; _botName = b['name']; }); _load(); },
        ),
    ]));
  }

  @override Widget build(BuildContext context) {
    return Scaffold(backgroundColor: Colors.transparent, body: SafeArea(child: SingleChildScrollView(padding: const EdgeInsets.fromLTRB(16, 8, 16, 100), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
      // 顶部栏
      Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
        Text(_now(), style: const TextStyle(fontSize: 17, fontWeight: FontWeight.w700, fontFamily: 'TideFont', color: Color(0xFF1C1C1E))),
        GestureDetector(onTap: _selectBot, child: Row(children: [
          Text(_nowTime(), style: const TextStyle(fontSize: 15, fontFamily: 'TideFont', color: Color(0xFF6B5B95))),
          const SizedBox(width: 8),
          Text(_botName, style: const TextStyle(fontSize: 13, fontFamily: 'TideFont', color: Color(0xFF8E8E93))),
          const Icon(Icons.arrow_drop_down, size: 18, color: Color(0xFF8E8E93)),
        ])),
      ]),
      const SizedBox(height: 16),

      // 今日一言卡片
      GlassCard(radius: 20, padding: const EdgeInsets.all(18), child: Row(children: [
        Container(width: 40, height: 40, decoration: BoxDecoration(shape: BoxShape.circle, gradient: const LinearGradient(colors: [Color(0xFF6B5B95), Color(0xFF9B8EC4)])), child: const Center(child: Text('言', style: TextStyle(color: Colors.white, fontWeight: FontWeight.w700, fontFamily: 'TideFont')))),
        const SizedBox(width: 14),
        Expanded(child: Text(_dailyQuote, style: const TextStyle(fontSize: 14, height: 1.4, fontFamily: 'TideFont', color: Color(0xFF3C3C43)))),
      ])),
      const SizedBox(height: 10),

      // 相遇天数卡片
      GlassCard(radius: 20, padding: const EdgeInsets.all(18), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Text('与$_botName的第$_daysSince天', style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700, fontFamily: 'TideFont', color: Color(0xFF1C1C1E))),
        const SizedBox(height: 4),
        Text('$_meetDate 这一天你们相遇了', style: const TextStyle(fontSize: 12, color: Color(0xFF8E8E93), fontFamily: 'TideFont')),
      ])),
      const SizedBox(height: 10),

      // 心情 + 日程卡片
      GlassCard(radius: 20, padding: const EdgeInsets.all(18), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Text(_moodIcon(_mood), style: const TextStyle(fontSize: 28)),
          const SizedBox(width: 8),
          Text('今日心情: $_mood', style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w600, fontFamily: 'TideFont', color: Color(0xFF1C1C1E))),
        ]),
        const SizedBox(height: 12),
        const Text('最近日程', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600, color: Color(0xFF8E8E93), fontFamily: 'TideFont')),
        if (_schedules.isEmpty) const Padding(padding: EdgeInsets.only(top: 6), child: Text('暂无日程', style: TextStyle(fontSize: 12, color: Color(0xFFC7C7CC), fontFamily: 'TideFont')))
        else ..._schedules.map((s) => ListTile(dense: true, contentPadding: EdgeInsets.zero, title: Text(s['title'] ?? '', style: const TextStyle(fontSize: 13, fontFamily: 'TideFont')), subtitle: Text(s['time'] ?? '', style: const TextStyle(fontSize: 11, fontFamily: 'TideFont')), onTap: () => _showAllSchedules())),
      ])),
      const SizedBox(height: 10),

      // 日记卡片
      GlassCard(radius: 20, padding: const EdgeInsets.all(18), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
          const Text('机器人日记', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600, color: Color(0xFF8E8E93), fontFamily: 'TideFont')),
          GestureDetector(onTap: () => _openDiary(), child: const Text('查看全部 >', style: TextStyle(fontSize: 12, color: Color(0xFF6B5B95), fontFamily: 'TideFont'))),
        ]),
        if (_diaries.isEmpty) const Padding(padding: EdgeInsets.only(top: 6), child: Text('暂无日记', style: TextStyle(fontSize: 12, color: Color(0xFFC7C7CC), fontFamily: 'TideFont')))
        else ..._diaries.map((d) => Padding(padding: const EdgeInsets.only(top: 8), child: Text(d['content'] as String? ?? '', maxLines: 2, overflow: TextOverflow.ellipsis, style: const TextStyle(fontSize: 13, fontFamily: 'TideFont', color: Color(0xFF3C3C43))))),
      ])),
    ]))));
  }

  String _moodIcon(String m) {
    switch (m) { case '开心': return '😊'; case '难过': return '😢'; case '生气': return '😤'; case '平静': return '😌'; case '期待': return '🤩'; default: return '😊'; }
  }

  void _showAllSchedules() {
    showTideSheet(context: context, height: 400, child: Column(children: [
      const SizedBox(height: 8),
      const Text('全部日程', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w700, fontFamily: 'TideFont')),
      Expanded(child: ListView(children: _schedules.map((s) => ListTile(title: Text(s['title'] ?? '', style: const TextStyle(fontFamily: 'TideFont')), subtitle: Text(s['time'] ?? '', style: const TextStyle(fontFamily: 'TideFont')))).toList())),
    ]));
  }

  void _openDiary() {
    Navigator.push(context, PageRouteBuilder(pageBuilder: (c, a, s) => Scaffold(
      appBar: AppBar(title: const Text('机器人日记', style: TextStyle(fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
      body: ListView(children: [
        const Padding(padding: EdgeInsets.all(16), child: Text('长期记忆', style: TextStyle(fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
        const Padding(padding: EdgeInsets.symmetric(horizontal: 16), child: Text('功能预留，下次更新开放', style: TextStyle(color: Color(0xFF8E8E93), fontFamily: 'TideFont'))),
        const Divider(),
        const Padding(padding: EdgeInsets.all(16), child: Text('中期记忆', style: TextStyle(fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
        ..._diaries.map((d) => ListTile(title: Text(d['content'] as String? ?? '', style: const TextStyle(fontFamily: 'TideFont')))),
        const Divider(),
        const Padding(padding: EdgeInsets.all(16), child: Text('短期记忆', style: TextStyle(fontWeight: FontWeight.w700, fontFamily: 'TideFont'))),
        const Padding(padding: EdgeInsets.symmetric(horizontal: 16), child: Text('功能预留，下次更新开放', style: TextStyle(color: Color(0xFF8E8E93), fontFamily: 'TideFont'))),
      ]),
    ), transitionsBuilder: (c, a, s, child) => SlideTransition(position: Tween<Offset>(begin: const Offset(0.15, 0), end: Offset.zero).animate(CurvedAnimation(parent: a, curve: Curves.easeOutCubic)), child: child)));
  }
}

