class SquarePage extends StatefulWidget {
  const SquarePage({Key? key}) : super(key: key);
  @override State<SquarePage> createState() => _SquarePageState();
}
class _SquarePageState extends State<SquarePage> with SingleTickerProviderStateMixin {
  bool _isGame = false;
  late AnimationController _switchCtrl;
  @override void initState() { super.initState(); _switchCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 400)); }
  @override void dispose() { _switchCtrl.dispose(); super.dispose(); }

  void _toggle() {
    setState(() => _isGame = !_isGame);
    _isGame ? _switchCtrl.forward() : _switchCtrl.reverse();
  }

  @override Widget build(BuildContext context) {
    return Scaffold(backgroundColor: Colors.transparent, body: SafeArea(child: Column(children: [
      // 顶部栏
      Padding(padding: const EdgeInsets.fromLTRB(16, 8, 16, 8), child: Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
        AnimatedSwitcher(duration: const Duration(milliseconds: 300), child: Text(_isGame ? '小游戏' : '动态', key: ValueKey(_isGame), style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w800, fontFamily: 'TideFont', color: Color(0xFF1C1C1E)))),
        GestureDetector(
          onTap: _toggle,
          child: AnimatedBuilder(animation: _switchCtrl, builder: (c, _) => Container(
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
            decoration: BoxDecoration(color: const Color(0xFF6B5B95).withOpacity(0.15), borderRadius: BorderRadius.circular(20)),
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              Icon(_isGame ? Icons.grid_view_rounded : Icons.article_rounded, size: 18, color: const Color(0xFF6B5B95)),
              const SizedBox(width: 6),
              Text(_isGame ? '游戏' : '动态', style: const TextStyle(fontSize: 13, fontFamily: 'TideFont', color: Color(0xFF6B5B95))),
            ]),
          )),
        ),
      ])),
      Expanded(child: _isGame ? _gameView() : _feedView()),
    ])));
  }

  Widget _feedView() {
    return Stack(children: [
      ListView(padding: const EdgeInsets.fromLTRB(16, 4, 16, 100), children: [
        for (int i = 1; i <= 5; i++)
          GlassCard(radius: 18, padding: const EdgeInsets.all(16), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Row(children: [
              Container(width: 36, height: 36, decoration: const BoxDecoration(shape: BoxShape.circle, color: Color(0xFFE8E8F0)), child: const Icon(Icons.person, size: 20, color: Color(0xFF6B5B95))),
              const SizedBox(width: 10),
              Text('机器人动态 #$i', style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w600, fontFamily: 'TideFont')),
            ]),
            const SizedBox(height: 10),
            const Text('这是一条示例动态内容，展示了机器人发布的生活记录和想法。', style: TextStyle(fontSize: 13, fontFamily: 'TideFont', color: Color(0xFF3C3C43))),
            const SizedBox(height: 12),
            Row(mainAxisAlignment: MainAxisAlignment.spaceAround, children: [
              _actionBtn(Icons.favorite_border_rounded, '点赞'),
              _actionBtn(Icons.comment_rounded, '评论'),
              _actionBtn(Icons.bookmark_border_rounded, '收藏'),
              _actionBtn(Icons.share_rounded, '分享'),
            ]),
          ])).padding(const EdgeInsets.only(bottom: 12)),
      ]),
      // 发布悬浮球
      Positioned(right: 16, bottom: 20, child: GestureDetector(onTap: () { /* TODO: 发布动态 */ }, child: Container(width: 48, height: 48, decoration: BoxDecoration(shape: BoxShape.circle, gradient: const LinearGradient(colors: [Color(0xFF6B5B95), Color(0xFF9B8EC4)]), boxShadow: [BoxShadow(color: const Color(0xFF6B5B95).withOpacity(0.4), blurRadius: 14, offset: const Offset(0, 4))]), child: const Icon(Icons.edit_rounded, color: Colors.white, size: 22)))),
    ]);
