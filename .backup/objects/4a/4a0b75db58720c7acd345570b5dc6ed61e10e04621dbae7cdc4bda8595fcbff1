  Widget _actionBtn(IconData ic, String lb) {
    return GestureDetector(onTap: () {}, child: Row(mainAxisSize: MainAxisSize.min, children: [Icon(ic, size: 18, color: const Color(0xFF8E8E93)), const SizedBox(width: 3), Text(lb, style: const TextStyle(fontSize: 11, color: Color(0xFF8E8E93), fontFamily: 'TideFont'))]));
  }

  Widget _gameView() {
    final games = [
      {'icon': Icons.grid_on_rounded, 't': '五子棋', 's': '经典连珠对战'},
      {'icon': Icons.grid_4x4_rounded, 't': '井字棋', 's': '三连即胜'},
      {'icon': Icons.psychology_rounded, 't': '20问猜物', 's': 'AI和你猜谜语'},
      {'icon': Icons.casino_rounded, 't': '棋牌对战', 's': '3~10点数扑克'},
